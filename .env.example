# Copy this file to .env and fill in the keys you have. Leave a line empty to skip that source.
# Ticketmaster Discovery API (free): https://developer.ticketmaster.com
VITE_TICKETMASTER_KEY=
# SeatGeek Platform API (free): https://seatgeek.com/account/develop
VITE_SEATGEEK_CLIENT_ID=
# Accounts (optional, free): https://supabase.com → Project Settings → API.
# Leave empty and everything is saved on each device instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
